---
source: src/xray/config.rs
expression: cfg
---
{
  "api": {
    "services": [
      "StatsService"
    ],
    "tag": "api"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "ip": "127.0.0.1",
        "udp": true
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "tag": "socks-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {},
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "tag": "http-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "tag": "api"
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "observatory": {
    "enableConcurrency": true,
    "probeInterval": "10s",
    "probeUrl": "https://www.gstatic.com/generate_204",
    "subjectSelector": [
      "proxy-"
    ]
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "de.example.com",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "flow": "xtls-rprx-vision",
                "id": "b831381d-6324-4d53-ad4f-8cda48b30811"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "realitySettings": {
          "fingerprint": "chrome",
          "publicKey": "4GObrWHDR0TyD84iQ06z24v4YBxQ69vxeG1MCqOyFlI",
          "serverName": "www.microsoft.com",
          "shortId": "ab12cd34"
        },
        "security": "reality"
      },
      "tag": "proxy-primary"
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "ru.example.com",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "id": "b831381d-6324-4d53-ad4f-8cda48b30811"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "realitySettings": {
          "fingerprint": "chrome",
          "publicKey": "4GObrWHDR0TyD84iQ06z24v4YBxQ69vxeG1MCqOyFlI",
          "serverName": "ya.ru",
          "shortId": "ab"
        },
        "security": "reality"
      },
      "tag": "proxy-backup"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "policy": {
    "system": {
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "routing": {
    "balancers": [
      {
        "fallbackTag": "proxy-backup",
        "selector": [
          "proxy-primary"
        ],
        "strategy": {
          "type": "leastPing"
        },
        "tag": "proxy"
      }
    ],
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api",
        "type": "field"
      },
      {
        "balancerTag": "proxy",
        "domain": [
          "full:connectivitycheck.gstatic.com"
        ],
        "inboundTag": [
          "socks-in"
        ],
        "type": "field"
      },
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "balancerTag": "proxy",
        "network": "tcp,udp",
        "type": "field"
      }
    ]
  },
  "stats": {}
}
